  "position_sizing_function": {
    "pseudocode": "def size(equity, risk_pct, entry, stop, value_per_price_unit_per_lot, min_lot, lot_step):\n    risk_amt = equity * risk_pct/100\n    dist = abs(entry - stop)\n    lots = risk_amt / (dist * value_per_price_unit_per_lot)\n    lots = floor(lots/lot_step)*lot_step\n    if lots < min_lot: return 0  # risk too high for account, skip trade\n    return lots"
  },
  "regime_classifier": {
    "pseudocode": "def regime(adx, ema20, ema50, atr, atr_pct_rank):\n    if adx >= 25 and abs(ema20-ema50) > 0.5*atr: return 'TREND'\n    if adx < 20 and abs(ema20-ema50) < 0.5*atr: return 'RANGE'\n    if atr_pct_rank > 0.8: return 'EXPANSION'\n    if atr_pct_rank < 0.2: return 'CONTRACTION'\n    return 'UNCLEAR'",
